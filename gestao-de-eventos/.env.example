# Modelo de variaveis de ambiente para rodar com o profile "prod" (ver ADR-0014).
# Copie para ".env" e preencha com valores reais -- ".env" nao deve ser commitado.
# Isso e so referencia: o Spring Boot nao le ".env" sozinho, essas variaveis
# precisam ser exportadas no shell (ou cadastradas no painel do Render em producao).

SPRING_PROFILES_ACTIVE=prod

# JDBC URL sem usuario/senha embutidos -- o driver do Postgres nao aceita
# user:senha@host na authority da URL, por isso username/password ficam
# em variaveis separadas abaixo.
DATASOURCE_URL=jdbc:postgresql://<host>/<database>?sslmode=require&channel_binding=require
DATASOURCE_USERNAME=<usuario>
DATASOURCE_PASSWORD=<senha>

# Opcional: o Render injeta essa variavel automaticamente em runtime.
# So precisa ser setada manualmente ao rodar fora do Render.
PORT=8080

# ADR-0017: autenticacao (Spring Security + JWT). JWT_SECRET precisa ter pelo
# menos 32 bytes (HS256). ADMIN_USERNAME/ADMIN_PASSWORD so sao usados para criar
# o usuario unico no primeiro boot (tb_app_user vazia) -- depois disso, trocar a
# senha e via runbook manual (ver docs/runbooks/reset-senha.md), nao por aqui.
JWT_SECRET=<secret-aleatorio-com-pelo-menos-32-bytes>
JWT_EXPIRATION_MS=86400000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<senha-do-primeiro-boot>
